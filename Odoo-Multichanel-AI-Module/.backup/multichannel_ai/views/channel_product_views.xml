<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_channel_product_tree" model="ir.ui.view">
        <field name="name">channel.product.tree</field>
        <field name="model">channel.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="channel_id"/>
                <field name="product_id"/>
                <field name="channel_price"/>
                <field name="channel_qty"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_channel_product_form" model="ir.ui.view">
        <field name="name">channel.product.form</field>
        <field name="model">channel.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="channel_id"/>
                            <field name="product_id"/>
                            <field name="channel_price"/>
                            <field name="channel_qty"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_channel_product_search" model="ir.ui.view">
        <field name="name">channel.product.search</field>
        <field name="model">channel.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="channel_id"/>
                <field name="product_id"/>
            </search>
        </field>
    </record>

    <record id="action_channel_product" model="ir.actions.act_window">
        <field name="name">Channel Products</field>
        <field name="res_model">channel.product</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
