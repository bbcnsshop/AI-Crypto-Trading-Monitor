<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Engine Views -->
    <record id="view_ai_engine_tree" model="ir.ui.view">
        <field name="name">ai.engine.tree</field>
        <field name="model">ai.engine</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="provider"/>
                <field name="openrouter_model"/>
                <field name="vat_rate"/>
            </tree>
        </field>
    </record>
    
    <record id="view_ai_engine_form" model="ir.ui.view">
        <field name="name">ai.engine.form</field>
        <field name="model">ai.engine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Basic Info">
                            <field name="name"/>
                            <field name="provider"/>
                        </group>
                        <group string="OpenRouter Settings">
                            <field name="openrouter_api_key" password="1"/>
                            <field name="openrouter_base_url"/>
                            <field name="openrouter_model"/>
                        </group>
                    </group>
                    <group string="Fee Configuration">
                        <group>
                            <field name="default_platform_fee"/>
                            <field name="default_payment_fee"/>
                            <field name="default_shipping_fee"/>
                        </group>
                        <group>
                            <field name="vat_rate"/>
                        </group>
                    </group>
                    <group string="Local LLM (Ollama)">
                        <field name="local_endpoint" placeholder="http://localhost:11434/api/generate"/>
                        <field name="local_model" placeholder="llama3"/>
                    </group>
                    <notebook>
                        <page string="Category Mappings" name="mappings">
                            <field name="category_mapping_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_ai_engine" model="ir.actions.act_window">
        <field name="name">AI Engine</field>
        <field name="res_model">ai.engine</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <menuitem id="menu_ai_engine"
              name="AI Engine"
              parent="sale.sale_menu_root"
              action="action_ai_engine"
              sequence="5"/>
</odoo>