<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Frontend Actions (define first before menuitems reference them) -->
        <record id="action_mc_dashboard" model="ir.actions.act_url">
            <field name="name">Multi-Channel Dashboard</field>
            <field name="url">/multichannel/dashboard</field>
            <field name="target">self</field>
        </record>

        <record id="action_mc_products" model="ir.actions.act_url">
            <field name="name">Channel Products</field>
            <field name="url">/multichannel/products</field>
            <field name="target">self</field>
        </record>

        <record id="action_mc_sync" model="ir.actions.act_url">
            <field name="name">Sync Manager</field>
            <field name="url">/multichannel/sync</field>
            <field name="target">self</field>
        </record>

        <record id="action_mc_channels" model="ir.actions.act_url">
            <field name="name">Channels</field>
            <field name="url">/multichannel/channels</field>
            <field name="target">self</field>
        </record>

        <record id="action_mc_orders" model="ir.actions.act_url">
            <field name="name">Orders</field>
            <field name="url">/multichannel/orders</field>
            <field name="target">self</field>
        </record>
    </data>
    <data>
        <!-- Root menu under Sales -->
        <menuitem id="menu_online_sales_root"
                  name="Online Sales"
                  parent="sale.sale_menu_root"
                  sequence="50"
                  groups="base.group_user"/>

        <menuitem id="menu_manage_channels"
                  name="Manage Channels"
                  parent="menu_online_sales_root"
                  action="action_channel_config"
                  sequence="5"
                  groups="base.group_user"/>

        <menuitem id="menu_channel_list_module"
                  name="Channel List Modules"
                  parent="menu_online_sales_root"
                  action="action_channel_list_module"
                  sequence="3"
                  groups="base.group_user"/>

        <menuitem id="menu_channel_products"
                  name="Channel Products"
                  parent="menu_online_sales_root"
                  action="action_channel_product"
                  sequence="10"
                  groups="base.group_user"/>

        <menuitem id="menu_add_to_channel"
                  name="Add Products to Channel"
                  parent="menu_online_sales_root"
                  action="action_add_to_channel_bulk_wizard"
                  sequence="15"
                  groups="base.group_user"/>

        <menuitem id="menu_channel_images"
                  name="Channel Images"
                  parent="menu_online_sales_root"
                  action="action_channel_product_image"
                  sequence="18"
                  groups="base.group_user"/>

        <menuitem id="menu_channel_attributes"
                  name="Attribute Mappings"
                  parent="menu_online_sales_root"
                  action="action_channel_product_attribute"
                  sequence="19"
                  groups="base.group_user"/>

        <menuitem id="menu_field_mappings"
                  name="Field Mappings"
                  parent="menu_online_sales_root"
                  action="action_channel_field_mapping"
                  sequence="20"
                  groups="base.group_user"/>

        <menuitem id="menu_category_mapping"
                  name="Category Mappings"
                  parent="menu_online_sales_root"
                  action="action_category_mapping"
                  sequence="25"
                  groups="base.group_user"/>

        <menuitem id="menu_price_recommendation"
                  name="Price Recommendations"
                  parent="menu_online_sales_root"
                  action="action_price_recommendation"
                  sequence="30"
                  groups="base.group_user"/>

        <!-- Frontend web menus - separate root -->
        <menuitem id="menu_mc_frontend_root"
                  name="Multi-Channel"
                  sequence="100"
                  groups="base.group_user"/>

        <menuitem id="menu_mc_dashboard"
                  name="Dashboard"
                  parent="menu_mc_frontend_root"
                  action="action_mc_dashboard"
                  sequence="1"
                  groups="base.group_user"/>

        <menuitem id="menu_mc_products"
                  name="Channel Products"
                  parent="menu_mc_frontend_root"
                  action="action_mc_products"
                  sequence="5"
                  groups="base.group_user"/>

        <menuitem id="menu_mc_sync"
                  name="Sync Manager"
                  parent="menu_mc_frontend_root"
                  action="action_mc_sync"
                  sequence="10"
                  groups="base.group_user"/>

        <menuitem id="menu_mc_channels"
                  name="Channels"
                  parent="menu_mc_frontend_root"
                  action="action_mc_channels"
                  sequence="15"
                  groups="base.group_user"/>

        <menuitem id="menu_mc_orders"
                  name="Orders"
                  parent="menu_mc_frontend_root"
                  action="action_mc_orders"
                  sequence="20"
                  groups="base.group_user"/>
    </data>
</odoo>
