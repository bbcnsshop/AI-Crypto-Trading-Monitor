<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product.template form to add channel info -->
    <record id="view_product_template_form_channel" model="ir.ui.view">
        <field name="name">product.template.form.channel</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Channel Info" name="channel_info">
                    <group>
                        <group string="Channel Status">
                            <field name="is_on_shopee"/>
                            <field name="is_on_lazada"/>
                            <field name="is_on_tiktok"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
