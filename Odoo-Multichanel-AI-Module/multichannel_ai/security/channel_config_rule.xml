<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Manager rule: sees all channels in company -->
        <record id="channel_config_manager_rule" model="ir.rule">
            <field name="name">Channel Config: Manager sees all in company</field>
            <field name="model_id" ref="model_channel_config"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('multichannel_ai.group_multichannel_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
