</record>

<record id="channel_list_tiktok" model="channel.list.module">
    <field name="name">TikTok Shop</field>
    <field name="code">tiktok</field>
    <field name="icon">📱</field>
    <field name="sequence">30</field>
    <field name="active">True</field>
    <field name="is_installed">True</field>
    <field name="country_code">TH</field>
    <field name="currency_code">THB</field>
