# AI Crypto Trading Monitor - Environment Configuration
# Copy this file to .env and set your API keys

# ============================================================
# REQUIRED: OpenRouter API Key (for AI analysis)
# ============================================================
# Get it from https://openrouter.ai/
#OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================
# OPTIONAL: Binance API Keys (for higher rate limits)
# ============================================================
# Binance API keys allow higher rate limits and access to account info
# Without keys: Public market data (OHLCV) works fine, lower rate limit
# With keys: Higher rate limit (1200 req/min vs 50 req/min for public)
#
# Get API keys from: https://www.binance.com/en/my/settings/api-management
# Recommended: Create keys with "Read-Only" permission
#
# Leave blank if you dont have them - public data still works
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ============================================================
# OPTIONAL: OpenRouter Model
# ============================================================
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_MODEL=anthropic/claude-3-haiku
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================================
# OPTIONAL: Trading parameters (defaults used if not set)
# ============================================================
# SYMBOL=BTC/USDT
# TIMEFRAME=1h
# CANDLE_LIMIT=100
